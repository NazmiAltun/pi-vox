{
  "name": "pi-vox",
  "version": "0.1.0",
  "description": "Lightweight command-based voice dictation for Pi using ffmpeg and ElevenLabs.",
  "author": "Denis Mrvoljak",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "voice",
    "dictation",
    "elevenlabs",
    "speech-to-text"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "README.md",
    "LICENSE",
    "src/**/*.ts"
  ],
  "scripts": {
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "pack:smoke": "pnpm pack --dry-run",
    "validate": "pnpm run typecheck && pnpm test && pnpm run pack:smoke",
    "check": "pnpm run validate"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@types/node": "^25.9.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denismrvoljak/pi-vox.git"
  },
  "homepage": "https://github.com/denismrvoljak/pi-vox",
  "bugs": {
    "url": "https://github.com/denismrvoljak/pi-vox/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.30.1"
}
